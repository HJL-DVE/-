# ============================================================
# TeaClub 环境变量模板
# 使用方法：复制为 .env 并填写真实值；.env 已被 .gitignore 忽略
# ============================================================

# ---------------- 数据库 ----------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=teaclub
MYSQL_USER=teaclub
MYSQL_PASSWORD=

# ---------------- Redis ----------------
# 若使用 Redis，设置 TEACLUB_CACHE_PROVIDER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------- JWT ----------------
# 生成方式（PowerShell）：
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
# 管理端与会员端必须使用不同的密钥
JWT_ADMIN_SECRET=
JWT_MEMBER_SECRET=

# ---------------- 适配器开关 ----------------
# local  : 使用进程内缓存（无需 Redis，开发/演示环境推荐）
# redis  : 使用 Redis
TEACLUB_CACHE_PROVIDER=local

# mock       : Mock 支付适配器（无商户资质时使用，支付单会标记 provider=MOCK）
# wechat-v3  : 真实微信支付 API v3（需下方全部配置项）
TEACLUB_PAYMENT_PROVIDER=mock

# ---------------- 微信小程序 ----------------
WX_MINI_APP_ID=
WX_MINI_APP_SECRET=

# ---------------- 微信支付 API v3（仅 provider=wechat-v3 时必填） ----------------
WXPAY_MCH_ID=
WXPAY_MCH_SERIAL=
WXPAY_API_V3_KEY=
WXPAY_PRIVATE_KEY_PATH=
WXPAY_NOTIFY_URL=
