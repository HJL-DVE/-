# ============================================================
# TeaClub Docker Compose 环境变量（示例，复制为 .env.docker 后修改）
# ============================================================

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_PORT=3307

# Nacos
NACOS_PORT=8848
NACOS_GRPC_PORT=9848

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_DEFAULT_USER=teaclub
RABBITMQ_DEFAULT_PASS=change_me_rabbit

# Redis
REDIS_PORT=6379

# Gateway
GATEWAY_PORT=9000

# 各微服务数据库密码（连接用户 tc_<service> 由 init SQL 自动创建）
DB_PASSWORD_AUTH=change_me_auth
DB_PASSWORD_MEMBER=change_me_member
DB_PASSWORD_PRODUCT=change_me_product
DB_PASSWORD_WALLET=change_me_wallet
DB_PASSWORD_ORDER=change_me_order
DB_PASSWORD_PAYMENT=change_me_payment
DB_PASSWORD_MARKETING=change_me_marketing
DB_PASSWORD_REPORT=change_me_report

# JWT 双令牌密钥（生产必须换成随机长字符串）
JWT_ADMIN_SECRET=change_me_admin_jwt_secret_at_least_32_chars
JWT_MEMBER_SECRET=change_me_member_jwt_secret_at_least_32_chars

# 服务间内部令牌
INTERNAL_TOKEN=change_me_internal_token
DEV_TOKEN_ENDPOINT=false